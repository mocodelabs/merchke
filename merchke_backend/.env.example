# Copy to .env for local development (never commit .env)

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,merchke.onrender.com

# Render / Postgres
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://merchke.netlify.app
CSRF_TRUSTED_ORIGINS=https://merchke.onrender.com,https://merchke.netlify.app
# Used in emails (links back to the site)
FRONTEND_URL=https://merchke.netlify.app

# ── M-Pesa Daraja (developer.safaricom.co.ke) ──
# Leave the three secrets empty to run in simulation mode: every STK push
# "succeeds" instantly. Production MUST set them (and MPESA_SIMULATE=False).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://merchke.onrender.com/api/payments/mpesa/callback/
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# MPESA_SIMULATE=False

# ── Media storage (Render's disk is wiped on every deploy) ──
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Email (booking requests, job applications, listing-fee reminders) ──
# Without EMAIL_HOST, emails are printed to the console.
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Merchke <no-reply@merchke.co.ke>

# ── Merchi AI support agent ──
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
